# =============================================================================
# Copia este archivo como .env en la raiz del proyecto:
#     cp .env.example .env
#
# El .env esta en .gitignore, asi que cada quien mantiene el suyo.
# Lo consumen DOS cosas distintas y no se pisan entre si:
#
#   1. Docker Compose  -> sustituye las ${VARIABLES} del docker-compose.yml
#   2. La API en local -> DotNetEnv lee las claves con formato ConnectionStrings__*
#                         y Jwt__* cuando corres "dotnet run" fuera de Docker
# =============================================================================

# --- Oracle (las usa docker-compose) -----------------------------------------
ORACLE_PASSWORD=Admin123Password!
ORACLE_APP_USER=odontologia_user
ORACLE_APP_PASSWORD=Odontologia123!
ORACLE_PDB=FREEPDB1
ORACLE_PORT=1521

# --- API (las usa docker-compose) --------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

JWT_ISSUER=NexusOdonto
JWT_AUDIENCE=NexusOdontoApi
JWT_SIGNING_KEY=DevSigningKey-MustBeAtLeast32BytesLong!
JWT_EXPIRATION_MINUTES=60

# --- Solo para correr la API FUERA de Docker con "dotnet run" ----------------
# Apunta a localhost porque ahi no existe el DNS de la red de Docker.
# Docker Compose ignora estas dos: dentro del contenedor la cadena se arma
# con las variables de arriba y el host es "oracle-db".
ConnectionStrings__OracleConnection=User Id=odontologia_user;Password=Odontologia123!;Data Source=localhost:1521/FREEPDB1
